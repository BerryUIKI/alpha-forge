{
  "name": "investment-os",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first AI workspace for investment research",
  "type": "module",
  "scripts": {
    "dev": "cd apps/desktop && npm run tauri dev",
    "dev:web": "cd apps/desktop && npm run dev",
    "build": "cd apps/desktop && npm run build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm run typecheck --filter @investment-os/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "cd apps/desktop && npm run tauri"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "prettier": "^3",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vitest": "^3",
    "@testing-library/react": "^16",
    "@testing-library/jest-dom": "^6",
    "jsdom": "^25"
  }
}
